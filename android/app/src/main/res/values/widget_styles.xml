<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Weekday header in the Google-style month widget. -->
    <style name="KalWidgetMonthWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/kal_widget_month_muted</item>
    </style>

    <!-- One single-line event chip below a day number. -->
    <style name="KalWidgetMonthChip">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:background">@drawable/kal_widget_chip_bg</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:textColor">@color/kal_widget_month_on_accent</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
