<!--
  Status-bar small icon for reminders. Android renders it as a monochrome
  silhouette, so this is a plain white calendar glyph (no colour, no gradient);
  the launcher foreground would collapse into a blob here.

  Authored for the Kotlin rewrite (the Dioxus Android build never showed a
  notification); replace freely — only the name is referenced.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Calendar body: outline. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="2"
        android:pathData="M4,6 L20,6 L20,20 L4,20 Z" />

    <!-- Header band. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4,6 L20,6 L20,9 L4,9 Z" />

    <!-- The two binder rings. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,2 L9,2 L9,6 L7,6 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,2 L17,2 L17,6 L15,6 Z" />
</vector>
